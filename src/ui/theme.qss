/* Mimi — a dark stage, and watermelon.

   She is the subject, so the surface around her is a stage: near-black, out of
   the way, with the chrome floating on top of it as rounded glass rather than
   carved into it as boxes. Depth comes from the lift of white on glass and a
   brighter hairline on its top edge.

   Two accents, and the discipline is the point. Watermelon pink (#ff4d6d)
   carries everything active. Rind green is reserved for exactly one meaning —
   she is hearing you right now — and appears nowhere else in this file. */

QWidget {
  background: transparent;
  color: #f5f5f7;
  /* The system UI face, named explicitly. Nothing set a family at all before,
     so Qt fell back to its own default and none of the weights or the spacing
     matched what the rest of macOS draws. ".AppleSystemUIFont" is the SF the
     system itself uses; the rest are there in case it is ever unavailable. */
  font-family: ".AppleSystemUIFont", "SF Pro Text", "Helvetica Neue", sans-serif;
  font-size: 19px;
}

QLabel { background: transparent; }

/* The root paints itself (AmbientCanvas); nothing here. */
#root { background: transparent; }

/* ------------------------------------------------------------------ chrome */

/* The bar is the same surface as the content — that is what "unified title
   bar" means. Any distinct band here re-creates stacked web chrome. */
#titleBar {
  background: transparent;
  border-bottom: 1px solid #2a2c31;
}

/* Her name, set like a product name rather than a label: near-white, tight,
   slightly tracked. The old value was a blue-grey (#f5f5f7) borrowed from the
   accent ramp, which read as a disabled control sitting next to real ones. */
#wordmark {
  font-size: 18.5px;
  font-weight: 600;
  letter-spacing: 0.2px;
  color: #f5f5f7;
}

/* The hairline between her name and the places you can go. */
#chromeRule { background: #2a2c31; }

/* Status: a dot and a word, on the surface. No capsule -- a raised pill around
   two words is chrome around chrome, and it was the loudest thing in the bar. */
#statusPill { background: transparent; }
#statusDot  { font-size: 8px; color: #ff4d6d; }
#statusText {
  font-size: 17px;
  font-weight: 500;
  letter-spacing: 0.2px;
  color: #91929b;
}

/* Text-weight controls. Flat until touched, which is what keeps a toolbar
   readable as one row instead of a shelf of buttons. */
#mutePill {
  background: transparent;
  border: none;
  border-radius: 11px;
  color: #91929b;
  font-size: 17px;
  font-weight: 500;
  padding: 0px 10px;
}

/* Interrupting her. Present only while she talks, so it can afford to be the
   one thing in the bar carrying colour. */
#stopBtn {
  background: rgba(229, 72, 77, 0.14);
  border: none;
  border-radius: 11px;
  color: #ff8fa3;
  font-size: 17px;
  font-weight: 600;
  padding: 0px 12px;
  margin-right: 6px;
}
#stopBtn:hover { background: rgba(229, 72, 77, 0.26); color: #ffc2cc; }
#mutePill:hover   { background: rgba(255, 255, 255, 0.06); color: #f5f5f7; }
#mutePill:checked { background: rgba(229, 72, 77, 0.13); color: #ff8fa3; }

/* -------------------------------------------------------------------- home */

#home { background: transparent; }

/* The caption column. Left-aligned against her now rather than centred under
   an orb, and set considerably larger: with the chrome stripped back this type
   *is* the interface, and it has to be readable from as far away as she is
   visible from. */

/* The state, as a small tracked label over the exchange. It sits where a
   speaker name would in a subtitle, because that is what it is. */
#heroState {
  font-size: 12.5px;
  font-weight: 700;
  letter-spacing: 4px;
  color: #ff8fa3;
}

/* What you said: quiet, above, in quotes. Deliberately recessive -- you know
   what you said, and it is only here so her answer has something to answer. */
#heroSaid {
  font-size: 19px;
  font-weight: 400;
  color: #7a7b85;
  letter-spacing: 0.2px;
}

/* Her answer is the thing you actually came to read, so it is the largest type
   in the app by a clear margin. Display face, light weight: a headline, not a
   paragraph. */
#heroReply {
  font-size: 40px;
  font-weight: 300;
  line-height: 144%;
  color: #f5f5f7;
}

/* ----------------------------------------------------------- workspace dock */

/* The context tag over the tools: quiet accent caps that read as a label, not
   a button, even though tapping it cycles the workspace. */
#workspaceTag {
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 3px;
  color: #91929b;
}

/* --------------------------------------------------------------- canvas hint */

#canvasHint {
  font-size: 16px;
  color: #91929b;
  letter-spacing: 0.4px;
}

/* --------------------------------------------------------- shared headings */

#sectionHead {
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 4px;
  color: #ff6b85;
}

#sectionLead {
  font-size: 18px;
  color: #c9cad1;
  line-height: 165%;
}

#groupHead {
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 2.5px;
  color: #91929b;
}

#emptyState {
  font-size: 18px;
  color: #91929b;
  line-height: 175%;
}

/* ------------------------------------------------------------------ skills */

#skills, #skillsContent { background: transparent; }

/* Cards are raised layers, not outlined boxes: a step up the graphite ramp,
   brighter still on hover. No borders anywhere. */
#skillCard {
  background: rgba(255, 255, 255, 0.04);
  border: none;
  border-radius: 18px;
  text-align: left;
}
#skillCard:hover   { background: rgba(255, 255, 255, 0.07); }
#skillCard:pressed { background: rgba(255, 77, 109, 0.12); }

#skillTitle  { font-size: 18px; font-weight: 600; color: #f5f5f7; }
#skillPhrase { font-size: 17px; color: #ff8fa3; }
#skillDetail { font-size: 16.5px; color: #91929b; }

/* ---------------------------------------------------------------- composer */

/* The bar paints its own glass; the field inside is naked text. */
QLineEdit#commandField {
  background: transparent;
  border: none;
  color: #f5f5f7;
  font-size: 20px;
  selection-background-color: #c2183c;
}

/* --------------------------------------------------------- command palette */

/* The single command surface: a raised glass card on a dimmed scrim. */
#palettePanel {
  background: rgba(20, 21, 24, 0.96);
  border-radius: 22px;
}
QLineEdit#paletteField {
  background: transparent;
  border: none;
  color: #f5f5f7;
  font-size: 22px;
  padding: 16px 20px;
  selection-background-color: #c2183c;
}
QListWidget#paletteList {
  background: transparent;
  border: none;
  outline: none;
  padding: 6px 8px;
  font-size: 18px;
}
QListWidget#paletteList::item {
  color: #f5f5f7;
  padding: 9px 12px;
  border-radius: 18px;
}
QListWidget#paletteList::item:selected {
  background: rgba(255, 77, 109, 0.18);
  color: #f5f5f7;
}

/* ------------------------------------------------------------- scrollbars */

QScrollBar:vertical {
  background: transparent;
  width: 10px;
  margin: 4px 2px;
}
QScrollBar::handle:vertical {
  background: rgba(255, 255, 255, 0.10);
  border-radius: 3px;
  min-height: 40px;
}
QScrollBar::handle:vertical:hover { background: rgba(255, 77, 109, 0.50); }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QToolTip {
  background: #212328;
  color: #c9cad1;
  border: none;
  border-radius: 12px;
  padding: 6px 10px;
  font-size: 17px;
}
