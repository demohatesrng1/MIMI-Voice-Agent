/* Mimi.
   Near-black, one accent, hairline separators, generous space. The previous
   pass leaned on glow and gradients everywhere, which reads as decoration
   rather than design; this one gets its structure from precise edges and
   spacing, and spends colour only where it carries meaning. */

QWidget {
  background: transparent;
  color: #e6e8f2;
  font-family: "Hiragino Sans", "SF Pro Text", "Helvetica Neue", sans-serif;
  font-size: 13.5px;
}

QLabel { background: transparent; }

#root { background: #0a0b10; }

/* ----------------------------------------------------------------- chrome */

#titleBar {
  background: #0d0f16;
}

#titleName {
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.4px;
  color: #e6e8f2;
}

#titleJp {
  font-size: 11px;
  letter-spacing: 3px;
  color: #6f6bb5;
}

#statusDot   { font-size: 9px; color: #4dd8e6; }
#statusText  { font-size: 11.5px; color: #7b829f; letter-spacing: 0.2px; }

/* Only shown while the mic is actually open. Outlined, not filled: it is a
   fact to be able to check, not an alarm. */
#micBadge {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.4px;
  color: #d4526f;
  border: 1px solid rgba(212, 82, 111, 0.45);
  border-radius: 3px;
  padding: 2px 5px;
}

#hairline {
  border: none;
  background: #1a1d29;
}

/* ------------------------------------------------------------------- rail */

#rail { background: #0d0f16; }

#power {
  background: transparent;
  border: 1px solid #232735;
  border-radius: 17px;
  color: #6b7396;
  font-size: 13px;
}
#power:checked   { color: #58e28b; border-color: rgba(88, 226, 139, 0.45); }
#power:!checked  { color: #d4526f; border-color: rgba(212, 82, 111, 0.45); }
#power:hover     { background: rgba(255, 255, 255, 0.05); }

/* ------------------------------------------------------------------- chat */

#chatPanel, #chatContent { background: #0a0b10; }

/* Her replies carry no bubble at all -- just an accent rule down the left.
   At conversation length, two facing bubble shapes is noise; an asymmetric
   pair reads faster and looks calmer. */
#bubbleMimi {
  background: transparent;
  border-left: 2px solid #6f6bb5;
  padding: 2px 0px 2px 14px;
  line-height: 172%;
  color: #dfe2ef;
}

#bubbleYou {
  background: #151824;
  border: 1px solid #232735;
  border-radius: 10px;
  padding: 9px 14px;
  line-height: 168%;
  color: #b9c0d8;
}

#bubbleSystem {
  background: transparent;
  color: #4e5470;
  font-size: 11px;
  letter-spacing: 0.6px;
  padding: 2px 0px;
}

/* ------------------------------------------------------------ suggestions */

#suggestions { background: #0a0b10; }

#chip {
  background: transparent;
  border: 1px solid #232735;
  border-radius: 13px;
  padding: 6px 13px;
  color: #8990ab;
  font-size: 12px;
}
#chip:hover {
  border-color: #3a3f78;
  color: #cdd2e6;
  background: rgba(111, 107, 181, 0.10);
}

/* --------------------------------------------------------------- composer */

#composer { background: #0d0f16; }

/* The border lives on the container, so the field, mic and send button read
   as one control instead of three. */
#field {
  background: #12141d;
  border: 1px solid #232735;
  border-radius: 21px;
}
#field:focus-within { border-color: #3a3f78; }

#input {
  background: transparent;
  border: none;
  color: #e6e8f2;
  font-size: 13.5px;
  padding: 0px 4px;
  selection-background-color: #4a4590;
}

#mic {
  background: transparent;
  border: none;
  border-radius: 15px;
  font-size: 14px;
  color: #8990ab;
}
#mic:hover    { background: rgba(255, 255, 255, 0.06); }
#mic:disabled { color: #333a52; }

#send {
  background: #6f6bb5;
  border: none;
  border-radius: 15px;
  color: #0a0b10;
  font-size: 15px;
  font-weight: 700;
}
#send:hover   { background: #837fc9; }
#send:pressed { background: #5f5ba3; }

/* ------------------------------------------------------------- scrollbars */

QScrollBar:vertical {
  background: transparent;
  width: 10px;
  margin: 4px 2px;
}
QScrollBar::handle:vertical {
  background: #232735;
  border-radius: 3px;
  min-height: 40px;
}
QScrollBar::handle:vertical:hover { background: #333a52; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QToolTip {
  background: #151824;
  color: #cdd2e6;
  border: 1px solid #232735;
  border-radius: 5px;
  padding: 5px 8px;
  font-size: 12px;
}
