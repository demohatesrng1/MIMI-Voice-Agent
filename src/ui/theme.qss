/* Mimi -- dark, neon, glassy.
   Descended from the palette in static/index.html, pushed further: deeper
   blacks so the accents actually glow, hairline borders instead of filled
   panels, and one saturated colour per state rather than a general wash. */

QWidget {
  background: transparent;
  color: #e8eaf6;
  font-family: "Hiragino Sans", "SF Pro Text", "Helvetica Neue", sans-serif;
  font-size: 14px;
}

QLabel { background: transparent; }

#root {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                              stop:0 #05070f, stop:0.55 #080b18, stop:1 #0d0a1c);
}

/* ---------------------------------------------------------------- sidebar */

#sidebar {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                              stop:0 rgba(20, 24, 48, 200),
                              stop:1 rgba(10, 12, 26, 220));
  border-right: 1px solid rgba(139, 124, 248, 40);
}

#brand {
  font-size: 26px;
  font-weight: 300;
  letter-spacing: 7px;
  color: #ffffff;
}

#brandJp {
  font-size: 11px;
  letter-spacing: 10px;
  color: #8b7cf8;
}

/* The state pill under the orb. Colour is set from code per state. */
#status {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 2.5px;
  color: #4dd8e6;
  border: 1px solid rgba(77, 216, 230, 70);
  border-radius: 11px;
  padding: 5px 0px;
  background: rgba(77, 216, 230, 18);
}

#hint {
  font-size: 12px;
  color: #7f88b0;
  line-height: 165%;
}

#sectionLabel {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 2.5px;
  color: #5a6291;
}

#rule {
  border: none;
  border-top: 1px solid rgba(139, 124, 248, 34);
  max-height: 1px;
}

#power {
  background: rgba(88, 226, 139, 16);
  border: 1px solid rgba(88, 226, 139, 90);
  border-radius: 12px;
  padding: 11px 14px;
  color: #58e28b;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 1.5px;
}
#power:hover { background: rgba(88, 226, 139, 30); }
#power:!checked {
  background: rgba(224, 90, 122, 16);
  border-color: rgba(224, 90, 122, 90);
  color: #e05a7a;
}

/* ------------------------------------------------------------------- chat */

#chatPanel { background: transparent; }
#chatContent { background: transparent; }

#topBar {
  background: rgba(10, 13, 28, 140);
  border-bottom: 1px solid rgba(139, 124, 248, 30);
}

#topTitle {
  font-size: 12px;
  letter-spacing: 1.5px;
  color: #9aa2c8;
}

#micBadge {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.5px;
  color: #e05a7a;
  border: 1px solid rgba(224, 90, 122, 80);
  border-radius: 9px;
  padding: 3px 9px;
  background: rgba(224, 90, 122, 20);
}

#bubbleMimi {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                              stop:0 rgba(28, 33, 66, 235),
                              stop:1 rgba(20, 24, 50, 235));
  border: 1px solid rgba(139, 124, 248, 55);
  border-left: 2px solid #8b7cf8;
  border-radius: 4px 16px 16px 16px;
  padding: 13px 17px;
  line-height: 165%;
}

#bubbleYou {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                              stop:0 rgba(24, 46, 62, 235),
                              stop:1 rgba(16, 32, 46, 235));
  border: 1px solid rgba(77, 216, 230, 60);
  border-right: 2px solid #4dd8e6;
  border-radius: 16px 4px 16px 16px;
  padding: 13px 17px;
  line-height: 165%;
  color: #e8f7fa;
}

#bubbleSystem {
  background: transparent;
  color: #5a6291;
  font-size: 11px;
  letter-spacing: 1px;
  padding: 2px 8px;
}

/* -------------------------------------------------------------- input bar */

#inputBar {
  background: rgba(10, 13, 28, 170);
  border-top: 1px solid rgba(139, 124, 248, 34);
}

#input {
  background: rgba(255, 255, 255, 10);
  border: 1px solid rgba(139, 124, 248, 46);
  border-radius: 21px;
  padding: 11px 18px;
  color: #e8eaf6;
  selection-background-color: #8b7cf8;
}
#input:focus {
  border-color: #8b7cf8;
  background: rgba(139, 124, 248, 20);
}

#send {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                              stop:0 #8b7cf8, stop:1 #6f5df0);
  border: none;
  border-radius: 21px;
  padding: 11px 24px;
  color: #05070f;
  font-weight: 700;
  letter-spacing: 1px;
}
#send:hover   { background: #9d90f9; }
#send:pressed { background: #6f5df0; }

#mic {
  background: rgba(77, 216, 230, 16);
  border: 1px solid rgba(77, 216, 230, 70);
  border-radius: 21px;
  font-size: 16px;
  color: #4dd8e6;
}
#mic:hover    { background: rgba(77, 216, 230, 34); }
#mic:disabled { color: #3b4160; border-color: rgba(139, 124, 248, 24); background: transparent; }

/* ------------------------------------------------------------- scrollbars */

QScrollBar:vertical {
  background: transparent;
  width: 8px;
  margin: 6px 2px;
}
QScrollBar::handle:vertical {
  background: rgba(139, 124, 248, 70);
  border-radius: 4px;
  min-height: 34px;
}
QScrollBar::handle:vertical:hover { background: rgba(139, 124, 248, 130); }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QToolTip {
  background: #131730;
  color: #e8eaf6;
  border: 1px solid rgba(139, 124, 248, 80);
  border-radius: 6px;
  padding: 6px 9px;
}
