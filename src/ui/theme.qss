/* Mimi — graphite and one electric blue.
   Depth over outlines: elevation comes from layered fills, light and shadow,
   never from borders. The accent is spent only on focus, state, and her.
   Type: SF Pro Display for display sizes, SF Pro Text for UI. */

QWidget {
  background: transparent;
  color: #f2f5f9;
  
  font-size: 14px;
}

QLabel { background: transparent; }

/* The root paints itself (AmbientCanvas); nothing here. */
#root { background: transparent; }

/* ------------------------------------------------------------------ chrome */

/* The bar is the same surface as the content — that is what "unified title
   bar" means. Any distinct band here re-creates stacked web chrome. */
#titleBar { background: transparent; }

#wordmark {
  font-size: 15px;
  font-weight: 600;
  color: #aeb6c4;
}

/* One status capsule: a raised sliver of glass holding a dot and a word. */
#statusPill {
  background: rgba(255, 255, 255, 0.045);
  border-radius: 14px;
}
#statusDot  { font-size: 8px; color: #1d4f94; }
#statusText {
  font-size: 12.5px;
  font-weight: 500;
  letter-spacing: 0.3px;
  color: #aeb6c4;
}

/* Mute, spelled out. Quiet glass at rest; unmistakably off when engaged. */
#mutePill {
  background: rgba(255, 255, 255, 0.05);
  border: none;
  border-radius: 15px;
  color: #aeb6c4;
  font-size: 12.5px;
  font-weight: 600;
  padding: 0px 16px;
}
#mutePill:hover   { background: rgba(255, 255, 255, 0.09); color: #f2f5f9; }
#mutePill:checked { background: rgba(255, 69, 96, 0.16); color: #ff8a9a; }

/* -------------------------------------------------------------------- home */

#home { background: transparent; }

/* The single most important word on screen: what she is doing right now. */
#heroState {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 5px;
  color: #4d9fff;
}

#heroSaid {
  font-size: 15px;
  color: #6b7689;
  letter-spacing: 0.2px;
}

/* Her answer is the thing you actually came to read, so it is the largest
   type in the app by a clear margin. Display face, light weight: a headline,
   not a paragraph. */
#heroReply {
  font-size: 28px;
  font-weight: 300;
  line-height: 150%;
  color: #f2f5f9;
}

/* --------------------------------------------------------- shared headings */

#sectionHead {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 4px;
  color: #4d9fff;
}

#sectionLead {
  font-size: 13px;
  color: #8a94a6;
  line-height: 165%;
}

#groupHead {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 2.5px;
  color: #515b6e;
}

#emptyState {
  font-size: 13px;
  color: #515b6e;
  line-height: 175%;
}

/* ------------------------------------------------------------------ skills */

#skills, #skillsContent { background: transparent; }

/* Cards are raised layers, not outlined boxes: a step up the graphite ramp,
   brighter still on hover. No borders anywhere. */
#skillCard {
  background: rgba(255, 255, 255, 0.04);
  border: none;
  border-radius: 14px;
  text-align: left;
}
#skillCard:hover   { background: rgba(255, 255, 255, 0.07); }
#skillCard:pressed { background: rgba(61, 139, 255, 0.12); }

#skillTitle  { font-size: 13px; font-weight: 600; color: #f2f5f9; }
#skillPhrase { font-size: 12px; color: #8fc0ff; }
#skillDetail { font-size: 11.5px; color: #515b6e; }

/* ---------------------------------------------------------------- composer */

/* The bar paints its own glass; the field inside is naked text. */
QLineEdit#commandField {
  background: transparent;
  border: none;
  color: #f2f5f9;
  font-size: 15px;
  selection-background-color: #1d4f94;
}

/* ------------------------------------------------------------- scrollbars */

QScrollBar:vertical {
  background: transparent;
  width: 10px;
  margin: 4px 2px;
}
QScrollBar::handle:vertical {
  background: rgba(255, 255, 255, 0.10);
  border-radius: 3px;
  min-height: 40px;
}
QScrollBar::handle:vertical:hover { background: rgba(61, 139, 255, 0.45); }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QToolTip {
  background: #161a23;
  color: #d7dfe9;
  border: none;
  border-radius: 6px;
  padding: 6px 10px;
  font-size: 12px;
}
