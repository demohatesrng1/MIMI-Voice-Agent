/* Mimi — black and pink.
   One hue, used at four weights, against near-black. State is signalled by
   intensity rather than by a different colour each time, so the palette keeps
   meaning something. Structure comes from hairlines and spacing, not from
   boxes inside boxes. */

QWidget {
  background: transparent;
  color: #f3f3f8;
  font-family: "Hiragino Sans", "SF Pro Text", "Helvetica Neue", sans-serif;
  font-size: 13.5px;
}

QLabel { background: transparent; }

#root { background: #08080c; }

#hairline { border: none; background: #24242f; }

/* ------------------------------------------------------------------ chrome */

#titleBar { background: #10101a; }

#wordmark {
  font-size: 12.5px;
  font-weight: 800;
  letter-spacing: 3.5px;
  color: #f3f3f8;
}

#wordmarkJp {
  font-size: 11px;
  letter-spacing: 4px;
  color: #ff2d87;
}

#statusDot  { font-size: 8px; color: #9e1853; }
#statusText { font-size: 11px; color: #87879c; letter-spacing: 0.5px; }

/* Only visible while the mic is genuinely open. */
#micBadge {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1.6px;
  color: #ff2d87;
  border: 1px solid rgba(255, 45, 135, 0.40);
  border-radius: 3px;
  padding: 2px 7px;
}

/* -------------------------------------------------------------------- rail */

#rail { background: #10101a; }

/* NavTab paints its own icon and selection bar; it only needs a null frame. */
#navTab {
  background: transparent;
  border: none;
}

#power {
  background: transparent;
  border: 1px solid #24242f;
  border-radius: 16px;
}
#power:checked  { color: #ff2d87; border-color: rgba(255, 45, 135, 0.45); }
#power:!checked { color: #ff4560; border-color: rgba(255, 69, 96, 0.45); }
#power:hover    { background: rgba(255, 255, 255, 0.05); }

/* -------------------------------------------------------------------- home */

#home { background: #08080c; }

/* The single most important word on screen: what she is doing right now. */
#heroState {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 5px;
  color: #ff2d87;
}

#heroSaid {
  font-size: 14px;
  color: #6c6c82;
  letter-spacing: 0.3px;
}

/* Her answer is the thing you actually came to read, so it is the largest
   type in the app by a clear margin. */
#heroReply {
  font-size: 25px;
  font-weight: 300;
  line-height: 152%;
  color: #f3f3f8;
}

#tile {
  background: #10101a;
  border: 1px solid #24242f;
  border-radius: 11px;
  color: #a4a4ba;
  font-size: 12.5px;
  text-align: left;
  padding: 0px 16px;
}
#tile:hover {
  background: rgba(255, 45, 135, 0.09);
  border-color: rgba(255, 45, 135, 0.40);
  color: #ffffff;
}
#tile:pressed { background: rgba(255, 45, 135, 0.18); }

/* --------------------------------------------------------- shared headings */

#sectionHead {
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 3.5px;
  color: #ff2d87;
}

#sectionLead {
  font-size: 13px;
  color: #6c6c82;
  line-height: 165%;
}

#groupHead {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2.5px;
  color: #55556a;
}

#emptyState {
  font-size: 13px;
  color: #4d4d60;
  line-height: 175%;
}

/* ---------------------------------------------------------------- activity */

#activity, #activityContent, #skills, #skillsContent { background: #08080c; }

#activityRow {
  background: #10101a;
  border: 1px solid #1c1c27;
  border-radius: 10px;
}
#activityRow:hover { border-color: #2c2c3c; }

#rowTime  { font-size: 11px; color: #4d4d60; }
#rowSaid  { font-size: 12.5px; color: #6c6c82; }
#rowReply { font-size: 13.5px; color: #e4e4ee; line-height: 155%; }

/* Present only when she actually changed something on the machine. */
#rowBadge {
  font-size: 9.5px;
  font-weight: 700;
  letter-spacing: 0.8px;
  color: #ff2d87;
  background: rgba(255, 45, 135, 0.12);
  border: 1px solid rgba(255, 45, 135, 0.30);
  border-radius: 4px;
  padding: 3px 8px;
}

/* ------------------------------------------------------------------ skills */

#skillCard {
  background: #10101a;
  border: 1px solid #24242f;
  border-radius: 12px;
  text-align: left;
}
#skillCard:hover {
  background: rgba(255, 45, 135, 0.07);
  border-color: rgba(255, 45, 135, 0.42);
}
#skillCard:pressed { background: rgba(255, 45, 135, 0.15); }

#skillTitle  { font-size: 13px; font-weight: 600; color: #f3f3f8; }
#skillPhrase { font-size: 12px; color: #ff7ab4; }
#skillDetail { font-size: 11.5px; color: #55556a; }

/* --------------------------------------------------- title-bar command field */

/* The one input, living in the chrome. Recessed rather than raised: it should
   read as part of the bar, not as a control sitting on top of it. */
#omni {
  background: #05050a;
  border: 1px solid #1e1e2a;
  border-radius: 14px;
  color: #f3f3f8;
  font-size: 12.5px;
  padding: 5px 14px;
  selection-background-color: #9e1853;
}
#omni:hover { border-color: #2a2a39; }
#omni:focus {
  background: #0a0a12;
  border-color: rgba(255, 45, 135, 0.55);
}

#micInline {
  background: transparent;
  border: none;
  border-radius: 14px;
}
#micInline:hover    { background: rgba(255, 45, 135, 0.14); }
#micInline:disabled { background: transparent; }

/* ------------------------------------------------------------- scrollbars */

QScrollBar:vertical {
  background: transparent;
  width: 10px;
  margin: 4px 2px;
}
QScrollBar::handle:vertical {
  background: #24242f;
  border-radius: 3px;
  min-height: 40px;
}
QScrollBar::handle:vertical:hover { background: #9e1853; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QToolTip {
  background: #16161f;
  color: #e4e4ee;
  border: 1px solid #2c2c3c;
  border-radius: 5px;
  padding: 5px 9px;
  font-size: 12px;
}
