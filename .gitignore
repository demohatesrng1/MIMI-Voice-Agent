# --- build output ------------------------------------------------------------
build/
cmake-build-*/
compile_commands.json
*.o
*.a
*.dylib
.cache/

# --- models ------------------------------------------------------------------
# ~1 GB of ONNX and GGML weights. Fetched by scripts/fetch_models.sh instead.
models/
voices/*.onnx
voices/*.onnx.json

# --- avatar ------------------------------------------------------------------
# The VRM body and its VRoid Studio master. The model's own licence is
# avatarPermission: onlyAuthor with redistribution and modification prohibited,
# so it cannot live in a repo or ship in a release -- it is placed by hand,
# exactly like the models above. See CLAUDE.md section 7.
*.vrm
*.vroid

# --- agent notes -------------------------------------------------------------
# Working notes for Claude: the architecture map, the invariants and the avatar
# plan. Local to this checkout, not part of the published project.
CLAUDE.md

# --- VOICEVOX CORE -----------------------------------------------------------
# Prebuilt engine + ONNX Runtime + Open JTalk dict + voice models. Fetched by
# scripts/fetch_voicevox.sh instead.
voicevox_core/

# --- retired python implementation -------------------------------------------
# Superseded by src/. Kept on disk for reference, out of the repo. Still in
# history before the C++ rewrite if it is ever needed.
venv/
__pycache__/
*.pyc
app.py
mimi.py
model.py
speech.py
tools.py
journal.py
reflect.py
website_extractor.py
requirements.txt
static/

# --- personal data -----------------------------------------------------------
# config.json holds the account salt and password hash.
# journal/, digests/, pages/ and profile.md are a record of what the user
# actually reads and says. None of it belongs in a repo.
config.json
profile.md
journal/
digests/
notes/
pages/
website_text.txt
mimi_launch.log

# --- generated test fixtures -------------------------------------------------
# Audio is regenerated with `say`; the reference scores are checked in because
# `mimi_wake --compare` needs them.
testdata/*.wav

# --- macOS -------------------------------------------------------------------
.DS_Store
*.icloud
